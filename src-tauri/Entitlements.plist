<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only. Replace TEAMID with your Apple Team ID (twice).
     Note what is NOT here: no network entitlement and no file access.
     The sandbox therefore guarantees the app cannot go online or read files. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>TEAMID.app.softmousewiggler</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAMID</string>
</dict>
</plist>
