<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package description. The three {{PLACEHOLDERS}} are
     filled in by make-msix.ps1 with the values Partner Center gives you
     (Product identity page). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SoftMouseWiggler</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
    <Resource Language="de-de" />
    <Resource Language="es-es" />
    <Resource Language="pt-pt" />
  </Resources>

  <Applications>
    <Application Id="SoftMouseWiggler" Executable="softmousewiggler.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SoftMouseWiggler"
        Description="Free, open-source mouse wiggler and auto clicker"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Lets the user switch on "start with Windows" in
             Settings > Apps > Startup. Off unless they choose it. -->
        <desktop:Extension Category="windows.startupTask" Executable="softmousewiggler.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SoftMouseWigglerStartup" Enabled="false" DisplayName="SoftMouseWiggler" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- An ordinary desktop program (it has to send mouse input). No internet capability is requested. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
